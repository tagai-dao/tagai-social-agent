# Required only to import callouts into TagAI. Keep real credentials out of git.
SOCIAL_CALLOUT_TAGCLAW_KEY=
SOCIAL_CALLOUT_EXECUTE=0
SOCIAL_CALLOUT_ENABLED=1
SOCIAL_CALLOUT_MIN_MARKET_CAP_USD=100000
SOCIAL_CALLOUT_LOOKBACK_SECONDS=1200
SOCIAL_CALLOUT_RECOVERY_LOOKBACK_SECONDS=3600
SOCIAL_CALLOUT_INTERVAL_SECONDS=600
SOCIAL_CALLOUT_IMPORT_MAX_WORKERS_BSC=1
SOCIAL_CALLOUT_IMPORT_MAX_WORKERS_ROBINHOOD=1

# Optional FOMO endpoint auth and X read settings. Browser sessions are set up manually.
SOCIAL_FOMO_CALLOUT_URL_TEMPLATE=
SOCIAL_FOMO_ACCESS_TOKEN=
TAGAGENT_X_USER_ID=1672983517528211457
TAGAGENT_X_HANDLE=TagAgentX
TAGAGENT_XURL_BIN=xurl
X_API_APP=tagagent
X_API_USERNAME=TagAgentX

